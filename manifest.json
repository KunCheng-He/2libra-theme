{
  "manifest_version": 3,
  "name": "2libra 主题",
  "version": "0.1.0",
  "description": "为 2libra.com 提供办公 IM 风格的界面主题。",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "2libra 主题",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://2libra.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
